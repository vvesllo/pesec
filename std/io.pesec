const cpesec = import {
    if (__platform == "linux")
        "cpesec/io/libio.so"
    else
        throw "Unsupported platform";
};

const print = fn(args) {
    for arg in args
        cpesec.write("cpesec.stdout", arg);
};

const input = fn(args) {
    for arg in args
        cpesec.write("cpesec.stdout", arg);
    cpesec.read("cpesec.stdin");
};