# written by deepseek! #

const cpesec = if (__platform == "linux")
    import "cpesec/io/libio.so"
else throw "Unsupported platform";

const Stream = struct {
    mutab fd = 0;
    mutab mode = "r";
    mutab is_open = true;

    const read = fn(size) {
        if (this.is_open == false) {
            "Error: Stream is closed";
        } else {
            cpesec.builtin_read(this.fd, size);
        };
    };

    const write = fn(data) {
        if (this.is_open == false) {
            "Error: Stream is closed";
        } else {
            cpesec.builtin_write(this.fd, data);
        };
    };

    const close = fn() {
        if (this.is_open) {
            this.is_open = false;
            cpesec.builtin_close(this.fd);
            "Successfully closed";
        } else {
            "Already closed";
        };
    };
};

const stdin = struct {
    mutab fd = 0;
    const read_line = fn() {
        cpesec.builtin_read(this.fd, 1024);
    };
};

const stdout = struct {
    mutab fd = 1;
    const print = fn(text) {
        cpesec.builtin_write(this.fd, text);
    };
};

const stderr = struct {
    mutab fd = 2;
    const print_err = fn(text) {
        cpesec.builtin_write(this.fd, "ERROR: " + text);
    };
};

const open_file = fn(filename, mode) {
    const fd = cpesec.builtin_open(filename, mode);

    const file_stream = struct {
        mutab fd = fd;
        mutab mode = mode;
        mutab is_open = true;

        const write = fn(data) {
            if (this.is_open == false) {
                "Error: Stream is closed";
            } else {
                cpesec.builtin_write(this.fd, data);
            };
        };

        const read = fn(size) {
            if (this.is_open == false) {
                "Error: Stream is closed";
            } else {
                cpesec.builtin_read(this.fd, size);
            };
        };

        const close = fn() {
            this.is_open = false;
            cpesec.builtin_close(this.fd);
        };
    };

    file_stream;
};

stdout.print("Hello, PESEC!\n");

const my_file = open_file("data.txt", "w");
my_file.write("This is a test string.");
const close_status = my_file.close();

const user_input = stdin.read_line();