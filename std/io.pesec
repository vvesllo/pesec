const cpesec = if (__platform == "linux")
     import "cpesec/io/libio.so"
else throw "Unsupported platform";

const Stream = struct {
    mutab fd = 0;
    mutab mode = "r";        # Режим: "r", "w", "a" и т.д.
    mutab is_open = true;    # Состояние потока

    const read = fn(size) {
        if (this.is_open == false) {
            "Error: Stream is closed";
        } else {
            # Вызов встроенной функции интерпретатора
            __builtin_read(this.fd, size);
        }
    };

    const write = fn(data) {
        if (this.is_open == false) {
            "Error: Stream is closed";
        } else {
            __builtin_write(this.fd, data);
        }
    };

    const close = fn() {
        if (this.is_open) {
            this.is_open = false;
            __builtin_close(this.fd);
            "Successfully closed";
        } else {
            "Already closed";
        }
    };
};

# ==========================================
# 2. Стандартные потоки (предопределенные)
# ==========================================
const stdin = struct {
    mutab fd = 0;
    const read_line = fn() {
        __builtin_read_line(this.fd);
    };
};

const stdout = struct {
    mutab fd = 1;
    const print = fn(text) {
        __builtin_write(this.fd, text);
    };
};

const stderr = struct {
    mutab fd = 2;
    const print_err = fn(text) {
        __builtin_write(this.fd, "ERROR: " + text);
    };
};

# ==========================================
# 3. Работа с файлами
# ==========================================
const open_file = fn(filename, mode) {
    # __builtin_open - гипотетическая функция интерпретатора,
    # которая обращается к ОС и возвращает новый файловый дескриптор
    const fd = __builtin_open(filename, mode);

    # Создаем и возвращаем новый экземпляр структуры для этого файла
    const file_stream = struct {
        mutab fd = fd;
        mutab mode = mode;
        mutab is_open = true;

        const write = fn(data) {
            if (this.is_open == false) {
                "Error: Stream is closed";
            } else {
                __builtin_write(this.fd, data);
            }
        };

        const read = fn(size) {
            if (this.is_open == false) {
                "Error: Stream is closed";
            } else {
                __builtin_read(this.fd, size);
            }
        };

        const close = fn() {
            this.is_open = false;
            __builtin_close(this.fd);
        };
    };

    file_stream; # Возврат значения из функции (как показано в примерах с loop/if)
};