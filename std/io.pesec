const cpesec = if (__platform == "linux")
    import "cpesec/io/libio.so"
else throw "Unsupported platform";

const print = fn(args) {
    for arg in args
        cpesec.write("cpesec.stdout", arg);
};

const input = fn(args) {
    for arg in args
        cpesec.write("cpesec.stdout", arg);
    cpesec.read("cpesec.stdin");
};