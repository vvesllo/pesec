const io = import "../std/io.pesec";

# function definition #
mutab f = fn() {
    io.println("one");
};

f();

# instant call #
mutab a = fn() { "two"; } ();

io.println(a);

fn() {
    io.println("three");
} ();

# functions can look like this #
f = fn(x) x * x;

io.println(f(0));
io.println(f(1));
io.println(f(2));

io.println(f);

# *args #
const g = fn(*args) {
    io.println(args);
};

g(79, 123);