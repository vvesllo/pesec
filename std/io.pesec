const cpesec = if (__platform == "linux")
    import "cpesec/io/libio.so"
else throw "Unsupported platform";

const stdin  = 0;
const stdout = 1;
const stderr = 2;

const print = fn(*text) for i in text cpesec._write(stdout, i);
const input  = fn() cpesec._read(stdin, 1024);

const open = fn(path, mode) {
    const fd = cpesec._open(path, mode);
    struct {
        mutab fd = fd;
        mutab mode = mode;
        mutab is_open = true;
        mutab cpesec = cpesec;

        const write = fn(data) {
            if (this.is_open == false) {
                throw "Stream is closed";
            } else {
                this.cpesec._write(this.fd, data);
            };
        };

        const read = fn(size) {
            if (this.is_open == false) {
                throw "Stream is closed";
            } else {
                this.cpesec._read(this.fd, size);
            };
        };

        const close = fn() {
            this.is_open = false;
            this.cpesec._close(this.fd);
        };
    };
};